{
	"name": "aura-enact",
	"version": "4.0.1",
	"description": "Aura IA Enact - assistente nativo (React + Spotlight) para Smart TV LG webOS",
	"author": "DevIA",
	"main": "src/index.js",
	"scripts": {
		"serve": "enact serve",
		"pack": "enact pack",
		"pack-p": "enact pack -p",
		"pack-webos": "enact pack -p && ares-package ./dist -o ./bin",
		"webos": "node scripts/webos.mjs",
		"sim": "node scripts/webos.mjs sim",
		"deploy": "node scripts/webos.mjs deploy",
		"inspect": "node scripts/webos.mjs inspect",
		"watch": "enact pack --watch",
		"clean": "enact clean",
		"lint": "enact lint .",
		"license": "enact license",
		"test": "enact test",
		"test-watch": "enact test --watch"
	},
	"license": "UNLICENSED",
	"private": true,
	"repository": "",
	"enact": {
		"theme": "sandstone",
		"ri": {
			"baseSize": 24
		}
	},
	"browserslist": [
		"Chrome >= 68"
	],
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "^4.9.8",
		"@enact/i18n": "^4.9.8",
		"@enact/sandstone": "^2.9.13",
		"@enact/spotlight": "^4.9.8",
		"@enact/ui": "^4.9.8",
		"@enact/webos": "^4.9.8",
		"@fontsource/outfit": "^5.3.0",
		"core-js": "^3.22.8",
		"ilib": "^14.21.2",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@enact/cli": "^6.1.4",
		"eslint-config-enact-proxy": "^1.0.9"
	}
}
